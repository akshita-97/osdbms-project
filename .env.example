# Copy this file to ".env" and fill in your actual local MySQL credentials.
# Never commit your real .env file with real passwords.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_sql_password
DB_NAME=smartlab_db

SECRET_KEY=change-this-to-any-random-string
FLASK_DEBUG=True

# Default Round Robin time quantum, in minutes (optional algorithm)
DEFAULT_TIME_QUANTUM=10
